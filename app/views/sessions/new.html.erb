<div class="auth__card">
  <h1 class="auth__title" style="color:#fff">土地バンク</h1>
  <div class="card">
    <%= render "shared/flash" %>
    <%= form_with url: login_path, class: "stack" do |f| %>
      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "username" %>
      </div>
      <div class="field" style="margin-top:16px">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password" %>
      </div>
      <div style="margin-top:24px"><%= f.submit "ログイン", class: "button button--primary button--block" %></div>
    <% end %>
  </div>
</div>
